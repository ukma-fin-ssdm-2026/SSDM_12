@startuml deployment
' UniSlot — цільова публічна топологія на Render без контейнерного runtime.
' Публічне розгортання ще не виконане; діаграма описує підготовлену конфігурацію.
title UniSlot — цільове публічне розгортання з межами довіри
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60

actor "Оператор\n(команда SSDM_12)" as ops

rectangle "Z0: Інтернет — недовірена зона" as z0 #line.dashed {
  node "Пристрій користувача" as device {
    node "Веббраузер" <<execution environment>> as browser {
      artifact "Web UI\n(HTML/CSS/JS)" as webui
    }
  }
}

cloud "Render Platform\n(Frankfurt)" as render {
  rectangle "Z1: HTTPS периметр Render" as z1 #line.dashed {
    node "Managed HTTPS edge" as edge
  }
  rectangle "Z2: застосунок" as z2 #line.dashed {
    node "Native Python Web Service" as api {
      component "FastAPI + Uvicorn\nREST API, Web UI, Swagger" as fastapi
      artifact "Python 3.12 source" as source
    }
    node "Native Python Worker" as worker {
      component "Outbox dispatcher\nі розширення горизонту" as worker_app
    }
  }
  rectangle "Z3: managed data service" as z3 #line.dashed {
    database "Managed PostgreSQL 16" as db
    note right of db
      API/Worker: окрема runtime роль
      operator migrations: owner role
      owner URL не передається застосунку
    end note
  }
}

rectangle "Z4: зовнішній провайдер доставки" as z4 #line.dashed {
  cloud "Провайдер e-mail\n(у семестрі — заглушка\nвсередині Worker, C-002)" as mail
}

webui --> edge : <b>TB1</b> HTTPS 443\nREST API і UI з одного origin
edge --> api : <b>TB2</b> внутрішня маршрутизація\nRender
api --> db : <b>TB3</b> приватний SQL\nruntime role
worker --> db : <b>TB3</b> приватний SQL\nruntime role
worker ..> mail : <b>TB4</b> SMTP/HTTPS\n(після заміни заглушки)
ops --> render : <b>TB5</b> HTTPS\nпанель і secret env vars
ops ..> db : <b>TB5</b> TLS, зовнішній URL\nлише для первинного налаштування/міграцій

legend bottom right
  Z0…Z4 — зони з різним рівнем довіри; TB1…TB5 — межі довіри.
  API та Worker підключаються до PostgreSQL внутрішнім URL одного регіону.
  Вхідна точка API — HTTPS; demo auth вимкнено, сесійна cookie Secure.
  GitHub Pages залишається лише статичною документацією.
endlegend
@enduml
