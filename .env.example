# Optional persistent mode. Blank selects the in-memory demo.
# scripts/manage_db.py local-init creates the restricted role URL in .env.local.
UNISLOT_DATABASE_URL=
UNISLOT_DEMO_AUTH=0
UNISLOT_EXPORT_OPENAPI=0
# Failure injection is read by the separate Worker, never the booking request.
UNISLOT_NOTIFICATION_FAILURE=0
# Keep secure cookies for HTTPS. local-init explicitly writes 0 for loopback HTTP.
UNISLOT_SESSION_COOKIE_SECURE=1
UNISLOT_SESSION_TTL_SECONDS=28800
# Provisional runtime settings; OQ-001 still needs a team decision.
UNISLOT_LOGIN_MAX_FAILURES=5
UNISLOT_LOGIN_COOLDOWN_SECONDS=300
